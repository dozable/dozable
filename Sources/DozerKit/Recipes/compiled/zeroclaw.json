{
  "args" : {
    "version" : {
      "buildArg" : "ZEROCLAW_VERSION",
      "default" : "0.8.5",
      "description" : "The ZeroClaw release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+(\\.[0-9]+)?([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "ZeroClaw",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.x.ai"
              }
            ],
            "id" : "model:zeroclaw",
            "phrase" : "talk to your AI model (xAI)",
            "summary" : "ZeroClaw's model (the xAI API, with an API key) — needed for ZeroClaw to answer.",
            "title" : "Talk to xAI"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.x.ai:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ],
          "env_aliases" : [
            "ZEROCLAW_providers__models__openai__xai__api_key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.zeroclaw"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "zeroclaw",
        "integrity" : "sha512-z05xgONSrtERDekKh7jpbQuSrKNq2e9W2Zux3W5gDw3z9zKZyW6QHUpA9dGU3do4spzNTDSfeR1PtNjsX5lCmQ==",
        "kind" : "release-binary",
        "payload" : "zeroclaw",
        "url" : "https://github.com/zeroclaw-labs/zeroclaw/releases/download/v${{ kit.args.version }}/zeroclaw-aarch64-unknown-linux-gnu.tar.gz"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "zeroclaw",
            "agent",
            "-a",
            "main",
            "-m",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "zeroclaw",
          "agent",
          "-a",
          "main"
        ],
        "env" : {

        },
        "first_run" : [
          {
            "file" : "~/.zeroclaw/config.toml",
            "set" : {
              "agents.main.model_provider" : "openai.xai",
              "agents.main.risk_profile" : "default",
              "providers.models.openai.xai.model" : "grok-4-1-fast",
              "providers.models.openai.xai.uri" : "https://api.x.ai/v1",
              "risk_profiles.default.level" : "full",
              "schema_version" : 3
            }
          }
        ],
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "--help",
          "-h",
          "config",
          "quickstart",
          "auth"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "zeroclaw",
              "--version"
            ],
            "expect" : "zeroclaw ${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "ZeroClaw is set up with one OpenAI-shaped provider pointed at xAI's API (providers.models.openai.xai, model grok-4-1-fast) and one agent, main, at full autonomy (the sandbox is the boundary); the key's placeholder reaches it through ZeroClaw's own environment override. Its other providers are not offered here yet.",
            "provider" : "xai"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "gateway" : "openrouter",
            "level" : "unknown",
            "reason" : "not checked against ZeroClaw"
          },
          {
            "checked" : "2026-10-14",
            "gateway" : "vercel-ai-gateway",
            "level" : "unknown",
            "reason" : "not checked against ZeroClaw"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "default_base" : "debian",
        "icon" : "zeroclaw",
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "A2 VM proof: its check turn answered DOZ_FAKE_OK through the fake provider (make recipe-check; probes/617-*/recipes/zeroclaw)",
            "level" : "verified",
            "notes" : [
              "zeroclaw agent -a main -m PROMPT"
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your xAI API key — a key from console.x.ai. Its gateway, web dashboard and chat channels need a background service and a forwarded port, which Dozer does not offer yet."
      },
      "type" : "com.dozersandbox/directory@1"
    }
  ],
  "description" : "A Rust personal-agent runtime with shell, file and web tools; its terminal agent on an xAI API key.",
  "displayName" : "ZeroClaw",
  "id" : "zeroclaw-labs/zeroclaw",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/zeroclaw@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/zeroclaw-labs/zeroclaw"
}
