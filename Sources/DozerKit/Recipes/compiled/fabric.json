{
  "args" : {
    "version" : {
      "buildArg" : "FABRIC_VERSION",
      "default" : "1.4.518",
      "description" : "The Fabric release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Daniel Miessler",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "generativelanguage.googleapis.com"
              }
            ],
            "id" : "model:fabric",
            "phrase" : "talk to your AI model (Google AI)",
            "summary" : "Fabric's model (the Gemini API, with an API key) — needed for Fabric to answer.",
            "title" : "Talk to Google AI"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "generativelanguage.googleapis.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "generativelanguage.googleapis.com",
              "format" : "%s",
              "header" : "x-goog-api-key"
            }
          ],
          "name" : "GEMINI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "google"
      },
      "description" : "Google AI (Gemini API) API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.config/fabric"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "fabric",
        "integrity" : "sha512-qTS9O3ps0FqHLqmgi1sV4U3u8LdRvJNV7Y5WYOQ48agmaIJoEVBKD9ghZ6LoakoFFQxc1wBr1LXKszCSCeH6kQ==",
        "kind" : "release-binary",
        "payload" : "fabric",
        "url" : "https://github.com/danielmiessler/Fabric/releases/download/v${{ kit.args.version }}/fabric_Linux_arm64.tar.gz"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "sh",
            "-c",
            "echo hello | fabric \"say ok\""
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "fabric"
        ],
        "env" : {

        },
        "first_run" : [
          {
            "file" : "~/.config/fabric/.env",
            "set" : {
              "DEFAULT_MODEL" : "gemini-2.5-flash",
              "DEFAULT_VENDOR" : "Gemini"
            }
          }
        ],
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "--help",
          "-h",
          "--setup",
          "-S"
        ],
        "session" : "shell",
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "fabric",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "Fabric reads GEMINI_API_KEY (its Gemini vendor); its other vendors (OpenAI, Anthropic, Ollama, …) Dozer does not offer here yet.",
            "provider" : "google"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "gateway" : "openrouter",
            "how" : {
              "args" : [
                "-V",
                "OpenRouter"
              ],
              "env" : {
                "OPENROUTER_API_KEY" : "${{ dozer.placeholder }}"
              },
              "model_args" : [
                "-m",
                "${{ dozer.model }}"
              ]
            },
            "level" : "documented",
            "notes" : [
              "Fabric has an OpenRouter vendor (OPENROUTER_API_KEY); Dozer offers gateways in a later version"
            ],
            "shape" : "openai-chat",
            "source" : "https://github.com/danielmiessler/Fabric"
          },
          {
            "checked" : "2026-10-14",
            "gateway" : "vercel-ai-gateway",
            "level" : "unknown",
            "reason" : "Fabric documents no Vercel AI Gateway vendor; its OpenAI-compatible vendors were not checked against it"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "default_base" : "debian",
        "icon" : "fabric",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "A2 VM proof: echo hello | fabric \"say ok\" answered DOZ_FAKE_OK through the fake provider (probes/617-*/recipes/fabric)",
            "level" : "verified",
            "notes" : [
              "echo TEXT | fabric -p PATTERN, or fabric \"a question\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your Gemini API key — a key from aistudio.google.com. Patterns are downloaded with fabric -U (GitHub)."
      },
      "type" : "com.dozersandbox/directory@1"
    }
  ],
  "description" : "A command-line prompt toolkit that applies crowd-sourced patterns to text, on a Gemini API key.",
  "displayName" : "Fabric",
  "id" : "danielmiessler/fabric",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/fabric@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/danielmiessler/Fabric"
}
