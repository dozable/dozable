{
  "args" : {
    "version" : {
      "buildArg" : "CODEBUDDY_VERSION",
      "default" : "2.164.0",
      "description" : "The CodeBuddy Code release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Tencent Cloud",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ]
              }
            ],
            "id" : "model:codebuddy",
            "phrase" : "talk to your AI model (xAI)",
            "summary" : "CodeBuddy Code's model here (the xAI API, with your key) — needed for it to answer.",
            "title" : "Talk to xAI"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.x.ai:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.codebuddy"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "binary" : "codebuddy",
        "integrity" : "sha512-1DvSEszHJQUysANsE1GF78dn6tWWjUpQYI4xZfJe5MTQqj3AfZDTywrNYJRKW2jTLYK8QaIX5rOSB8hUNFp8wA==",
        "kind" : "npm",
        "needs_node" : "22",
        "npm_args" : [
          "--ignore-scripts"
        ],
        "package" : "@tencent-ai/codebuddy-code"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "codebuddy",
            "--model",
            "grok-build",
            "-p",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "codebuddy",
          "--model",
          "grok-build"
        ],
        "env" : {
          "CODEBUDDY_DISABLE_BUILTIN_MODELS" : "1",
          "CODEBUDDY_DISABLE_PLUGIN_INSTALLS" : "1",
          "CODEBUDDY_DISABLE_TRACE_COLLECTOR" : "1",
          "CODEBUDDY_REMOTE_CONFIG_DISABLED" : "1",
          "CODEBUDDY_SKIP_BUILTIN_MARKETPLACE" : "1",
          "DISABLE_AUTOUPDATER" : "1",
          "DISABLE_TELEMETRY" : "1"
        },
        "first_run" : [
          {
            "file" : "~/.codebuddy/models.json",
            "set" : {
              "models" : [
                {
                  "apiKey" : "${XAI_API_KEY}",
                  "id" : "grok-build",
                  "maxInputTokens" : 200000,
                  "maxOutputTokens" : 8192,
                  "name" : "Grok Build (xAI)",
                  "supportsToolCall" : true,
                  "url" : "https://api.x.ai/v1/chat/completions",
                  "vendor" : "OpenAI"
                }
              ]
            }
          }
        ],
        "no_prompts_args" : [
          "--dangerously-skip-permissions"
        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "mcp",
          "config",
          "update",
          "plugin"
        ],
        "resume" : [
          "--continue"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "codebuddy",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "A custom model in ~/.codebuddy/models.json on xAI's API; its apiKey is the reference ${XAI_API_KEY}, which CodeBuddy reads from the environment each run, so the key is never written there. Its built-in models (a CodeBuddy account) are off.",
            "provider" : "xai"
          },
          {
            "account" : "a CodeBuddy account (Tencent Cloud)",
            "checked" : "2026-10-14",
            "in_sandbox" : false,
            "kind" : "vendor-sign-in",
            "note" : "CodeBuddy's own models need its sign-in; Dozer does not offer it yet. Its TUI offers that sign-in at start (Esc skips it)."
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "gateway" : "openrouter",
            "level" : "unknown",
            "reason" : "CodeBuddy takes any OpenAI-compatible custom model; OpenRouter was not checked"
          },
          {
            "checked" : "2026-10-14",
            "gateway" : "vercel-ai-gateway",
            "level" : "unknown",
            "reason" : "not checked against CodeBuddy"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "codebuddy-code",
          "cbc"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "node",
        "icon" : "codebuddy",
        "kind" : "coding-agent",
        "limits" : [
          {
            "musl" : true,
            "reason" : "not checked on Alpine"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: codebuddy -p \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "codebuddy --model grok-build -p \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your xAI API key — a key from console.x.ai. Its TUI offers CodeBuddy's sign-in when it starts; Esc skips it."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://www.codebuddy.ai/docs/cli",
        "intro" : "CodeBuddy Code is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "codebuddy --model grok-build -p \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "codebuddy --model grok-build -p \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Tencent's coding agent for the terminal, here with a custom model on an xAI API key (no CodeBuddy account).",
  "displayName" : "CodeBuddy Code",
  "id" : "tencent/codebuddy",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/codebuddy@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://www.codebuddy.ai/docs/cli"
}
