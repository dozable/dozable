{
  "args" : {
    "version" : {
      "buildArg" : "EVERY_CODE_VERSION",
      "default" : "0.6.196",
      "description" : "The Every Code release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "just-every",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ]
              }
            ],
            "id" : "model:every-code",
            "phrase" : "talk to your AI model (xAI)",
            "summary" : "Every Code's model here (the xAI API, with your key) — needed for it to answer.",
            "title" : "Talk to xAI"
          },
          "update" : [

          ],
          "vendor" : [
            {
              "host" : "api.github.com",
              "paths" : [
                "/repos/just-every/code/releases/latest"
              ],
              "reason" : "Every Code asks GitHub for its latest release when its TUI starts (read-only; no setting turns it off) and only shows a notice"
            }
          ]
        },
        "runtime" : {
          "allow" : [
            "api.x.ai:443",
            "api.github.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.code"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "binary" : "coder",
        "integrity" : "sha512-3Ss/lvzTxV1Z7C/y/0DHk3M7oCkV42FRCxp6t8twr2AtRIok43erm3BxTlmhmrOt/CjZGAMKOoaMgawzIOFvXg==",
        "kind" : "npm-platform-binary",
        "package" : "@just-every/code",
        "payload" : "bin/code-aarch64-unknown-linux-musl",
        "platform_package" : "@just-every/code-linux-arm64-musl"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "coder",
            "exec",
            "--skip-git-repo-check",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "coder"
        ],
        "env" : {

        },
        "first_run" : [
          {
            "file" : "~/.code/config.toml",
            "set" : {
              "model" : "grok-build-0.1",
              "model_provider" : "xai",
              "model_providers.xai.base_url" : "https://api.x.ai/v1",
              "model_providers.xai.env_key" : "XAI_API_KEY",
              "model_providers.xai.name" : "xAI",
              "model_providers.xai.wire_api" : "chat"
            }
          }
        ],
        "no_prompts_args" : [
          "--dangerously-bypass-approvals-and-sandbox"
        ],
        "passthrough" : [
          "--version",
          "-V",
          "--help",
          "-h",
          "help",
          "login",
          "logout",
          "exec",
          "auto",
          "mcp",
          "completion"
        ],
        "resume" : [
          "resume",
          "--last"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "coder",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Every Code's Codex-style model_providers table names xAI's API (env_key XAI_API_KEY, wire_api chat), model grok-build-0.1; its ChatGPT sign-in is not offered here.",
            "provider" : "xai"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "gateway" : "openrouter",
            "level" : "unknown",
            "reason" : "Every Code takes any model_providers entry, as Codex does; OpenRouter was not checked"
          },
          {
            "checked" : "2026-10-14",
            "gateway" : "vercel-ai-gateway",
            "level" : "unknown",
            "reason" : "not checked against Every Code"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "just-every-code",
          "coder"
        ],
        "default_base" : "debian",
        "icon" : "every-code",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: coder exec printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "coder exec --skip-git-repo-check \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your xAI API key — a key from console.x.ai."
      },
      "type" : "com.dozersandbox/directory@1"
    }
  ],
  "description" : "A Codex CLI fork with multi-agent orchestration (just-every/code), here on an xAI API key.",
  "displayName" : "Every Code",
  "id" : "just-every/every-code",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/every-code@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/just-every/code"
}
