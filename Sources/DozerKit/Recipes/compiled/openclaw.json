{
  "args" : {
    "version" : {
      "buildArg" : "OPENCLAW_VERSION",
      "default" : "2026.10.3",
      "description" : "The OpenClaw release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+(\\.[0-9]+)?([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "OpenClaw",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "generativelanguage.googleapis.com"
              }
            ],
            "id" : "model:openclaw",
            "phrase" : "talk to your AI model (Google AI)",
            "summary" : "OpenClaw's model (the Gemini API, with an API key) — needed for OpenClaw to answer.",
            "title" : "Talk to Google AI"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "generativelanguage.googleapis.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "generativelanguage.googleapis.com",
              "format" : "%s",
              "header" : "x-goog-api-key"
            }
          ],
          "name" : "GEMINI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "google"
      },
      "description" : "Google AI (Gemini API) API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.openclaw"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "binary" : "openclaw",
        "integrity" : "sha512-ncl6LntMlf76K39LFhVrDXQTbaGNAG5j52f7PL5P8vIn0knWmCrvfAe9DHMslFq+47HeOWBH2CBYQH8zEb+UAA==",
        "kind" : "npm",
        "needs_node" : "24",
        "package" : "openclaw"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "openclaw",
            "agent",
            "exec",
            "say ok",
            "--auth-env-only",
            "--model",
            "google/gemini-2.5-flash",
            "--timeout",
            "120"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "openclaw"
        ],
        "env" : {
          "OPENCLAW_NO_AUTO_UPDATE" : "1"
        },
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "--help",
          "-h"
        ],
        "session" : "shell",
        "state_env" : {
          "OPENCLAW_STATE_DIR" : "/home/agent/.openclaw"
        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "openclaw",
              "--version"
            ],
            "expect" : "OpenClaw ${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "OpenClaw reads GEMINI_API_KEY (openclaw agent exec --auth-env-only --model google/MODEL). Its other providers, its Gateway and its chat channels are not offered yet.",
            "provider" : "google"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "gateway" : "openrouter",
            "level" : "unknown",
            "reason" : "OpenClaw names OpenRouter among its providers; how its key and base URL are set was not checked"
          },
          {
            "checked" : "2026-10-14",
            "gateway" : "vercel-ai-gateway",
            "level" : "unknown",
            "reason" : "not checked against OpenClaw"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "default_base" : "debian",
        "icon" : "openclaw",
        "limits" : [
          {
            "musl" : true,
            "reason" : "OpenClaw needs Node 24, which Dozer installs on Debian-based bases only (Node publishes no musl arm64 build)"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "A2 VM proof: one agent exec turn answered DOZ_FAKE_OK through the fake provider (probes/617-*/recipes/openclaw)",
            "level" : "verified",
            "notes" : [
              "openclaw agent exec \"PROMPT\" --auth-env-only --model google/gemini-2.5-flash"
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your Gemini API key — a key from aistudio.google.com. Its Gateway (TUI, Control UI, chat channels) needs a background service and a forwarded port, which Dozer does not offer yet."
      },
      "type" : "com.dozersandbox/directory@1"
    }
  ],
  "description" : "A self-hosted personal agent with shell and file tools; its headless agent turn on a Gemini API key (its Gateway, TUI and chat channels later).",
  "displayName" : "OpenClaw",
  "id" : "openclaw/openclaw",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/openclaw@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/openclaw/openclaw"
}
