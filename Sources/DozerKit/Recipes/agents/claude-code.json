{
  "schema": 1,
  "id": "claude-code",
  "title": "Claude Code",
  "publisher": "Anthropic",
  "icon": "claude-code",
  "licence": "proprietary",
  "homepage": "https://code.claude.com",
  "aliases": ["claude"],
  "builtin": true,
  "default_base": "node",
  "platforms": { "glibc": true, "musl": true },
  "install": {
    "kind": "builtin",
    "package": "@anthropic-ai/claude-code",
    "binary": "claude",
    "pinned": {
      "version": "2.1.227",
      "integrity": "sha512-D0YP8GFwPaP/9eObEuP5LRO5+9QSD9CLa6K26whNzXxpxz3pFqPS3nn7l1/MLmSWy32wBP2IKQzkRB3mumUKUQ=="
    }
  },
  "launch": {
    "command": ["claude"],
    "no_prompts_args": ["--dangerously-skip-permissions"],
    "passthrough": [],
    "env": {}
  },
  "state": {
    "persist": ["~/.claude"],
    "env": { "CLAUDE_CONFIG_DIR": "/home/agent/.claude", "DISABLE_AUTOUPDATER": "1", "DISABLE_UPDATES": "1" }
  },
  "credentials": [{ "provider": "anthropic", "accounts": ["mac", "setup-token", "api-key"] }],
  "tags": [
    { "tag": "headless", "level": "documented", "source": "https://code.claude.com/docs/en/headless", "notes": ["claude -p"], "checked": "2026-10-12" }
  ],
  "gateways": [
    {
      "gateway": "openrouter",
      "level": "documented",
      "shape": "anthropic-messages",
      "endpoint": "anthropic",
      "how": {
        "env": {
          "ANTHROPIC_BASE_URL": "{gateway.endpoint.anthropic}",
          "ANTHROPIC_AUTH_TOKEN": "{placeholder}",
          "ANTHROPIC_API_KEY": "",
          "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
        },
        "model_args": ["--model", "{model}"]
      },
      "limits": ["only guaranteed with Anthropic's own models, Anthropic first in the provider order", "never with a Claude subscription (mac / setup-token): the gateway key replaces it"],
      "notes": ["~creator/…-latest aliases also work; a [1m] suffix marks a 1M context and OpenRouter strips it"],
      "source": "https://openrouter.ai/docs/guides/guides/claude-code-integration",
      "checked": "2026-10-12"
    },
    {
      "gateway": "vercel-ai-gateway",
      "level": "documented",
      "shape": "anthropic-messages",
      "endpoint": "claude-code",
      "how": {
        "env": {
          "ANTHROPIC_BASE_URL": "{gateway.endpoint.claude-code}",
          "ANTHROPIC_AUTH_TOKEN": "{placeholder}",
          "ANTHROPIC_API_KEY": "",
          "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
        },
        "model_args": ["--model", "{model}"]
      },
      "limits": ["never with a Claude subscription (mac / setup-token): the gateway key replaces it"],
      "notes": ["/claude-code is Claude Code's own compatibility endpoint; discovery puts every gateway model in /model"],
      "source": "https://vercel.com/docs/ai-gateway/coding-agents",
      "checked": "2026-10-12"
    }
  ],
  "auth": {
    "methods": [
      {
        "kind": "vendor-sign-in",
        "account": "a Claude subscription (Pro, Max, Team or Enterprise)",
        "accounts": ["mac", "setup-token"],
        "note": "This Mac's own Claude Code login (the account mac, read on the Mac and renewed by the Mac's Claude Code), or a token from claude setup-token. The sign-in stays on the Mac — the sandbox gets a placeholder.",
        "checked": "2026-10-12"
      },
      {
        "kind": "api-key",
        "provider": "anthropic",
        "keys_page": "https://platform.claude.com/settings/keys",
        "accounts": ["api-key"],
        "checked": "2026-10-12"
      }
    ]
  },
  "network": {
    "model": { "id": "model", "shared": true },
    "update": [
      { "host": "downloads.claude.ai" },
      { "host": "registry.npmjs.org", "paths": ["/@anthropic-ai/claude-code", "/@anthropic-ai%2fclaude-code", "/@anthropic-ai%2Fclaude-code"] }
    ],
    "excluded": [],
    "vendor": [
      { "host": "downloads.claude.ai", "paths": ["/model-catalog/"], "reason": "Claude Code reads Anthropic's list of models when it starts" },
      { "host": "downloads.claude.ai", "paths": ["/claude-code-releases/plugins/"], "reason": "Claude Code reads Anthropic's official plugin list (and fetches those plugins) when it starts" },
      { "host": "raw.githubusercontent.com", "exact_paths": ["/anthropics/claude-code/refs/heads/main/CHANGELOG.md"], "reason": "Claude Code reads its release notes (Anthropic's CHANGELOG.md on GitHub) when it starts" }
    ],
    "off_without": [
      { "permission": "error-reports", "env": { "DISABLE_ERROR_REPORTING": "1", "DISABLE_TELEMETRY": "1" }, "says": "Claude Code's error reports and usage data are turned off (Send error reports is off)" }
    ]
  },
  "status": "osc7501",
  "prompt": { "kind": "skill", "dir": "~/.claude/skills/dozer", "launcher_arg": ["--append-system-prompt"] },
  "resume": ["--continue"],
  "resume_check": "d=\"$HOME/.claude/projects/$(pwd -P | sed 's/[^A-Za-z0-9]/-/g')\"; ls \"$d\"/*.jsonl >/dev/null 2>&1 && echo resumable || echo none",
  "verify": [{ "argv": ["claude", "--version"], "expect": "{version}" }],
  "settings": { "version": "images.claude_code_version", "permissions": "claude.permissions" }
}
