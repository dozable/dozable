{
  "schema": 1,
  "id": "antigravity",
  "aliases": ["agy"],
  "title": "Antigravity CLI",
  "publisher": "Google",
  "licence": "Proprietary (Google Antigravity terms)",
  "homepage": "https://antigravity.google",
  "default_base": "debian",
  "platforms": { "glibc": true, "musl": false },
  "limits": [
    { "musl": true, "reason": "Dozer installs Antigravity CLI's glibc build only for now (Google publishes a musl build too; it is not checked yet)" }
  ],
  "install": {
    "kind": "manifest-binary",
    "manifest": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_arm64.json",
    "url": "https://storage.googleapis.com/antigravity-public/antigravity-cli/{build}/linux-arm/cli_linux_arm64.tar.gz",
    "payload": "antigravity",
    "binary": "agy",
    "bake_hosts": ["storage.googleapis.com"],
    "pinned": {
      "version": "1.3.3+5524738307653632",
      "integrity": "sha512-G/01A1diGaECF2wTV5ZlovOehKyGqQSxF9OzPz3XUfGUqGJJa61v/pFK1G0sh3uhK2wH5tsHEotwbSOCYv5DDA=="
    }
  },
  "launch": {
    "command": ["agy"],
    "no_prompts_args": ["--dangerously-skip-permissions"],
    "passthrough": ["--version", "-v", "--help", "-h", "help", "agent", "agents", "changelog", "install", "mcp", "models", "plugin",
                    "plugins", "update", "remote-control", "mic-serve"],
    "env": { "AGY_CLI_DISABLE_AUTO_UPDATE": "1" },
    "first_run": [
      {
        "file": "~/.gemini/antigravity-cli/settings.json",
        "set": { "modelProvider": "gemini", "enableTelemetry": false, "showFeedbackSurvey": false }
      }
    ]
  },
  "state": { "persist": ["~/.gemini", "~/.antigravity", "~/.agents"], "env": {} },
  "credentials": [{ "provider": "google", "accounts": ["key"] }],
  "tags": [
    { "tag": "headless", "level": "documented", "source": "https://antigravity.google/docs/cli/headless/", "notes": ["agy -p / --print, --output-format json|stream-json"], "checked": "2026-10-12" }
  ],
  "gateways": [
    {
      "gateway": "openrouter",
      "level": "unknown",
      "reason": "Antigravity CLI speaks the Gemini API with a key (GOOGLE_GEMINI_BASE_URL); its program also names undocumented AGY_LLM_GATEWAY_* settings, not checked",
      "checked": "2026-10-12"
    },
    {
      "gateway": "vercel-ai-gateway",
      "level": "unknown",
      "reason": "Antigravity CLI speaks the Gemini API with a key (GOOGLE_GEMINI_BASE_URL); its program also names undocumented AGY_LLM_GATEWAY_* settings, not checked",
      "checked": "2026-10-12"
    }
  ],
  "auth": {
    "methods": [
      {
        "kind": "api-key",
        "provider": "google",
        "keys_page": "https://aistudio.google.com/apikey",
        "accounts": ["key"],
        "note": "A Gemini API key (modelProvider gemini, GEMINI_API_KEY): Dozer never offers the Google sign-in, which keeps its token in a keyring on the machine.",
        "checked": "2026-10-12"
      }
    ]
  },
  "network": {
    "model": {
      "id": "model:antigravity",
      "title": "Talk to Google AI",
      "summary": "Antigravity CLI's model (the Gemini API, with an API key) — needed for Antigravity CLI to work.",
      "phrase": "talk to your AI model (Google AI)",
      "hosts": [{ "host": "generativelanguage.googleapis.com" }]
    },
    "update": [
      { "host": "antigravity-cli-auto-updater-974169037036.us-central1.run.app" },
      { "host": "storage.googleapis.com", "paths": ["/antigravity-public/antigravity-cli/"] }
    ],
    "excluded": ["accounts.google.com", "oauth2.googleapis.com", "cloudcode-pa.googleapis.com"],
    "vendor": [
      { "host": "antigravity-unleash.goog", "reason": "Antigravity CLI reads Google's feature switches for it (antigravity-unleash.goog) when it starts" }
    ],
    "quiet": [
      { "host": "play.googleapis.com", "reason": "Antigravity CLI's usage log to Google, every few seconds — its enableTelemetry setting does not stop it, so Dozer keeps it out without counting it as a refusal" }
    ]
  },
  "status": "none",
  "prompt": { "kind": "skill", "dir": "~/.agents/skills/dozer" },
  "resume": ["--continue"],
  "verify": [{ "argv": ["agy", "--version"], "expect": "{version}" }],
  "terms": "Closed source, installed from Google's own release (checksum-verified); a Gemini API key only.",
  "checked": "2026-10-12"
}
